# ─────────────────────────────────────────────────────────────────────────────
# TREC — Environment Variables
# Copy this to .env and fill in GEMINI_API_KEY and POSTGRES_PASSWORD at minimum
# ─────────────────────────────────────────────────────────────────────────────

# ─── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ─── Database ─────────────────────────────────────────────────────────────────
# For Docker Compose — keep host as "postgres" (service name)
POSTGRES_PASSWORD=trec_secret_2024
DATABASE_URL=postgresql://trec_user:trec_secret_2024@postgres:5432/trec_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev_secret_key_change_in_production_32x

# ─── AI — Google Gemini ───────────────────────────────────────────────────────
# REQUIRED: Get from https://aistudio.google.com/app/apikey (free)
GEMINI_API_KEY=AIzaSy_PASTE_YOUR_KEY_HERE

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost","http://localhost:3000"]

# ─── Frontend Build ───────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1

# ─── Domain (production only) ─────────────────────────────────────────────────
DOMAIN=localhost
